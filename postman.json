          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/all-users?page=1&limit=10&keyword=Nour",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "all-users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "keyword",
                  "value": "Nour"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Users listed', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "var json = pm.response.json();",
                  "var list = json.data || [];",
                  "var me = pm.collectionVariables.get('currentUserId');",
                  "var other = list.find(function (u) { return u._id !== me; });",
                  "if (other) pm.collectionVariables.set('userId', other._id);"
                ]
              }
            }
          ]
        },
