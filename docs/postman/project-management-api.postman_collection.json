          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data && json.data.length && json.data[0]._id) {",
                  "    pm.collectionVariables.set('userId', json.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/all-users?page=1&limit=10&keyword=",
              "host": [
                "{{baseUrl}}"
